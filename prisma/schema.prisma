generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiConnection {
  id             String       @id
  organizationId Int
  provider       String
  credentials    Json
  status         String       @default("pending")
  lastTestedAt   DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model AsanaAssigneeLoad {
  id                Int           @id @default(autoincrement())
  snapshotId        Int
  name              String
  email             String        @default("")
  totalOpen         Int           @default(0)
  overdue           Int           @default(0)
  dueSoon           Int           @default(0)
  completedThisWeek Int           @default(0)
  AsanaSnapshot     AsanaSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model AsanaSnapshot {
  id                 Int                 @id @default(autoincrement())
  organizationId     String              @default("default")
  syncedAt           DateTime            @default(now())
  totalOpen          Int                 @default(0)
  totalOverdue       Int                 @default(0)
  dueSoon            Int                 @default(0)
  completedThisWeek  Int                 @default(0)
  completedThisMonth Int                 @default(0)
  AsanaAssigneeLoad  AsanaAssigneeLoad[]
}

model CXHandoff {
  id                Int                 @id @default(autoincrement())
  clientName        String
  clientId          String?
  repName           String?
  closedAt          DateTime
  createdAt         DateTime            @default(now())
  pipelinePhase     String              @default("phase1-mvp")
  rawOutputJson     Json
  PromiseLedgerItem PromiseLedgerItem[]
  CXHandoffCall     CXHandoffCall[]

  @@unique([clientName, closedAt])
  @@index([closedAt])
}

model Client {
  id                String              @id
  acronym           String              @unique
  name              String
  sheetId           String
  funnelTab         String
  status            String              @default("active")
  teamNotes         String?
  notesBy           String?
  notesAt           DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime            @default(now())
  ClientFunnelMonth ClientFunnelMonth[]
}

model ClientFunnelMonth {
  id           String   @id
  clientId     String
  month        String
  locationName String   @default("default")
  leads        Int      @default(0)
  tours        Int      @default(0)
  registered   Int      @default(0)
  revenue      Float    @default(0)
  leadToTour   Float?
  tourToReg    Float?
  leadToReg    Float?
  syncedAt     DateTime @default(now())
  Client       Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, month, locationName])
}

model ClientGAMetrics {
  acronym            String
  propertyId         String   @map("propertyId")
  period             String
  sessions           Int      @default(0)
  activeUsers        Int      @default(0) @map("activeUsers")
  newUsers           Int      @default(0) @map("newUsers")
  bounceRate         Float    @default(0) @map("bounceRate")
  organicSearch      Int      @default(0) @map("organicSearch")
  paidSearch         Int      @default(0) @map("paidSearch")
  directSessions     Int      @default(0) @map("directSessions")
  organicSocial      Int      @default(0) @map("organicSocial")
  paidSocial         Int      @default(0) @map("paidSocial")
  referral           Int      @default(0)
  avgSessionDuration Float    @default(0) @map("avgSessionDuration")
  syncedAt           DateTime @default(now()) @map("syncedAt")

  @@id([acronym, period])
  @@index([period, sessions(sort: Desc)])
}

model DailyRevenue {
  id             Int      @id @default(autoincrement())
  date           String   @unique
  amount         Float
  chargeCount    Int      @default(0)
  syncedAt       DateTime @default(now())
  organizationId String   @default("default")
}

model Organization {
  id            Int             @id @default(autoincrement())
  name          String
  slug          String          @unique
  industry      String?
  logoUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  ApiConnection ApiConnection[]
  User          User[]
}

model PromiseLedgerItem {
  id             Int       @id @default(autoincrement())
  handoffId      Int
  promiseText    String
  category       String
  owner          String?
  confidence     String?
  riskFlag       String?
  reviewStatus   String    @default("Pending Review")
  reviewComment  String?
  evidenceSource String?
  evidenceLink   String?
  createdAt      DateTime  @default(now())
  CXHandoff      CXHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([handoffId])
  @@index([category])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model StripeCustomer {
  id             String    @id
  name           String?
  email          String?
  status         String
  mrr            Float     @default(0)
  createdAt      DateTime
  canceledAt     DateTime?
  updatedAt      DateTime
  organizationId String    @default("default")
}

model StripeMetrics {
  id               Int      @id @default(autoincrement())
  syncedAt         DateTime @default(now())
  mrr              Float
  totalRevenue     Float
  activeCustomers  Int
  newCustomers     Int
  churnedCustomers Int
  netRevenue       Float
  organizationId   String   @default("default")
}

model SyncLog {
  id             Int      @id @default(autoincrement())
  source         String
  status         String
  message        String?
  syncedAt       DateTime @default(now())
  organizationId String   @default("default")
}

model User {
  id             String       @id
  name           String
  email          String       @unique
  passwordHash   String?
  role           String       @default("viewer")
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])
  UserTeam       UserTeam[]
}

model UserTeam {
  id     String @id
  userId String
  team   String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, team])
}

model ReconDraft {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prospectName   String
  websiteUrl     String
  requestedBy    String
  status         String          @default("draft")
  rawAutoData    Json            @default("{}")
  validatedData  Json?
  reviewedBy     String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ReconLocation  ReconLocation[]

  @@index([status, createdAt(sort: Desc)])
}

model ReconLocation {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconDraftId  String     @db.Uuid
  locationName  String
  address       String?
  city          String?
  state         String?
  googleMapsUrl String?
  gbpClaimed    String     @default("unknown")
  gbpStatus     String     @default("not-found")
  reviewNotes   String?
  autoData      Json       @default("{}")
  manualData    Json?
  locationIndex Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  ReconDraft    ReconDraft @relation(fields: [reconDraftId], references: [id], onDelete: Cascade)

  @@index([reconDraftId, locationIndex])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ZoomCall {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId            String
  meetingUuid          String?
  meetingTopic         String?
  startedAt            DateTime?
  durationSecs         Int?
  repName              String?
  clientName           String?
  callDate             DateTime?       @db.Date
  callLink             String?
  matchMethod          String
  matchConfidence      Float           @default(0)
  matchReasonCode      String?
  sourceRef            String
  purposes             String[]
  createdAt            DateTime        @default(now())
  classificationStatus String?         @default("needs-confirmation")
  hostEmail            String?
  hostName             String?
  acronym              String?
  ZoomTranscript       ZoomTranscript?
  CallAnalysis         CallAnalysis[]
  CXHandoffCall        CXHandoffCall[]

  @@unique([meetingId, sourceRef])
  @@index([meetingId])
  @@index([callDate])
  @@index([clientName])
}

model ZoomTranscript {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomCallId            String                  @unique @db.Uuid
  vttRaw                String                  @db.Text
  parsedAt              DateTime?
  createdAt             DateTime                @default(now())
  ZoomCall              ZoomCall                @relation(fields: [zoomCallId], references: [id], onDelete: Cascade)
  ZoomTranscriptSegment ZoomTranscriptSegment[]

  @@index([zoomCallId])
}

model ZoomTranscriptSegment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId   String         @db.Uuid
  startMs        Int
  endMs          Int?
  speaker        String?
  text           String         @db.Text
  tags           String[]
  purposes       String[]
  createdAt      DateTime       @default(now())
  ZoomTranscript ZoomTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([startMs])
}

model CallAnalysis {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomCallId   String   @db.Uuid
  purpose      String
  analysisJson Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ZoomCall     ZoomCall @relation(fields: [zoomCallId], references: [id], onDelete: Cascade)

  @@unique([zoomCallId, purpose])
  @@index([purpose])
}

model CXHandoffCall {
  handoffId  Int
  zoomCallId String   @db.Uuid
  createdAt  DateTime @default(now())
  CXHandoff  CXHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  ZoomCall   ZoomCall  @relation(fields: [zoomCallId], references: [id], onDelete: Cascade)

  @@id([handoffId, zoomCallId])
  @@unique([handoffId, zoomCallId])
  @@index([zoomCallId])
}

model ZendeskAssigneeLoad {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  name            String
  openCount       Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskMonthlyVolume {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  month           String
  count           Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskOrgTicket {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  orgName         String
  orgId           String
  openCount       Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskResolutionBucket {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  label           String
  minHours        Float
  maxHours        Float
  count           Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskSnapshot {
  id                      Int                       @id @default(autoincrement())
  organizationId          String                    @default("default")
  syncedAt                DateTime                  @default(now())
  queueNew                Int                       @default(0)
  queueOpen               Int                       @default(0)
  queuePending            Int                       @default(0)
  queueHold               Int                       @default(0)
  queueTotal              Int                       @default(0)
  createdThisMonth        Int                       @default(0)
  resolvedThisMonth       Int                       @default(0)
  resolutionRate          Float                     @default(0)
  resTimeMean             Float                     @default(0)
  resTimeMedian           Float                     @default(0)
  resTimeMode             Float                     @default(0)
  resTimeSample           Int                       @default(0)
  typeWebsiteBuild        Int                       @default(0)
  typeWebsiteHelpdesk     Int                       @default(0)
  typeSMM                 Int                       @default(0)
  typeGoogleAds           Int                       @default(0)
  typeCRM                 Int                       @default(0)
  firstReplyTimeMean      Float                     @default(0)
  firstReplyTimeMedian    Float                     @default(0)
  firstReplyTimeSample    Int                       @default(0)
  overdueTickets          Int                       @default(0)
  ZendeskAssigneeLoad     ZendeskAssigneeLoad[]
  ZendeskMonthlyVolume    ZendeskMonthlyVolume[]
  ZendeskOrgTicket        ZendeskOrgTicket[]
  ZendeskResolutionBucket ZendeskResolutionBucket[]
}
