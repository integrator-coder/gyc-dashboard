  @@index([tenantId, status], map: "StripeInvoiceSnapshot_tenant_status_idx")
}

model StripeSubscriptionHistory {
  id              String    @id
  tenantId        String    @default("gyc")
  customerId      String
  subscriptionId  String
  productId       String?
  productName     String?
  productCategory String?
  priceId         String?
  amount          Decimal?  @db.Decimal(10, 2)
  currency        String?   @default("usd")
  interval        String?
  status          String?
  startDate       DateTime? @db.Timestamp(6)
  canceledAt      DateTime? @db.Timestamp(6)
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  syncedAt        DateTime? @default(now()) @db.Timestamp(6)

  @@index([customerId], map: "SSH_customerId_idx")
  @@index([productCategory], map: "SSH_productCategory_idx")
  @@index([startDate], map: "SSH_startDate_idx")
  @@index([status], map: "SSH_status_idx")
  @@index([tenantId], map: "SSH_tenantId_idx")
}

model TenantConfig {
  id               BigInt   @id @default(autoincrement())
  tenantId         String   @unique
  displayName      String
  industry         String?  @default("childcare")
  timezone         String?  @default("America/Toronto")
  stripeAccountId  String?
  ghlLocationId    String?
  ga4PropertyId    String?
  sheetsId         String?
  zendeskSubdomain String?
  activeModules    String[] @default(["finance", "sales", "cx"])
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @db.Timestamptz(6)
}

model WebAnalyticsSnapshot {
  id       BigInt   @id @default(autoincrement())
  asOf     DateTime @default(now()) @db.Timestamptz(6)
  payload  Json
  tenantId String   @default("gyc")

  @@index([asOf(sort: Desc)])
}

model GoogleAdsAccount {
  id              String   @id @default(cuid())
  accountId       String   @unique  // Google Ads customer ID
  accountName     String
  currSpend       Float    @default(0)
  currClicks      Int      @default(0)
  currImpressions Int      @default(0)
  currCpc         Float    @default(0)
  currCtr         Float    @default(0)
  prevSpend       Float    @default(0)
  prevClicks      Int      @default(0)
  prevImpressions Int      @default(0)
  prevCpc         Float    @default(0)
  cpcChange       Float?
  clicksChange    Float?
  impressionsChange Float?
  flagged         Boolean  @default(false)
  flags           String[] // array of flag strings
  lastSynced      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([flagged])
}

model GoogleAdsMonthlySnapshot {
  id          String   @id @default(cuid())
  monthKey    String   @unique  // "2026-01", "2026-02", etc.
  monthLabel  String   // "Jan 2026"
  isPartial   Boolean  @default(false)  // true = current in-progress month
  spend       Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  avgCpc      Float    @default(0)
  accountCount Int     @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AclDiscrepancy {
  id          String   @id @default(cuid())
  clientId    String?
  clientName  String
  acronym     String?
  changeType  String   // 'cancellation' | 'status_change' | 'mrr_mismatch' | 'evergreen_transition' | 'pif_activation'
  dbValue     String   // current value in DB
  stripeValue String   // what Stripe shows
  mrrImpact   Float?   // dollar impact
  status      String   @default("pending") // 'pending' | 'approved' | 'dismissed'
  dismissNote String?
  reviewedBy  String?
  reviewedAt  DateTime?
  syncRunAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AclSyncLog {
  id            String   @id @default(cuid())
  runAt         DateTime @default(now())
  clientsChecked Int
  discrepanciesFound Int
  syncType      String   // 'daily' | 'monthly'
  status        String   @default("completed")
}

model AIWatchVariable {
  id            String   @id @default(cuid())
  tenantId      String
  key           String   // e.g. "nvidia_pe_ratio", "vc_investment_quarterly"
  category      String   // "valuation" | "investment_flow" | "infrastructure" | "adoption" | "regulatory"
  label         String
  description   String?  @db.Text
  value         Float?
  previousValue Float?
  unit          String?  // "$B", "%", "TWh", "x" (multiple), etc.
  status        String   @default("green") // "green" | "yellow" | "red"
  trend         String?  // "up" | "down" | "stable"
  source        String?
  sourceUrl     String?
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, key])
}

model AIWatchSuspicion {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  description   String   @db.Text
  severity      String   // "watch" | "suspicion" | "alert"
  variables     String[] // array of variable keys involved
  historicalRef String?  // which bubble pattern this echoes
  isActive      Boolean  @default(true)
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([tenantId, isActive])
  @@index([tenantId, severity])
}

model AIWatchCompany {
  id            String   @id @default(cuid())
  tenantId      String
  ticker        String?
  name          String
  category      String   // "hardware" | "hyperscaler" | "ai_first_public" | "ai_first_private" | "physical_ai" | "energy_ai"
  currentPrice  Float?
  marketCap     Float?
  peRatio       Float?
  revenueMultiple Float?
  priceChange1d Float?
  priceChange7d Float?
  priceChange30d Float?
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([tenantId, category])
  @@index([ticker])
}

model AIWatchSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  bubbleScore     Float    // 0-10
  compositeStatus String   // "green" | "yellow" | "red"
  snapshotAt      DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([tenantId, snapshotAt(sort: Desc)])
}
