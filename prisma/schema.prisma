generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiConnection {
  id             String       @id
  organizationId Int
  provider       String
  credentials    Json
  status         String       @default("pending")
  lastTestedAt   DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  tenantId       String       @default("gyc")
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model AsanaAssigneeLoad {
  id                Int           @id @default(autoincrement())
  snapshotId        Int
  name              String
  email             String        @default("")
  totalOpen         Int           @default(0)
  overdue           Int           @default(0)
  dueSoon           Int           @default(0)
  completedThisWeek Int           @default(0)
  tenantId          String        @default("gyc")
  AsanaSnapshot     AsanaSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model AsanaSnapshot {
  id                 Int                 @id @default(autoincrement())
  organizationId     String              @default("default")
  syncedAt           DateTime            @default(now())
  totalOpen          Int                 @default(0)
  totalOverdue       Int                 @default(0)
  dueSoon            Int                 @default(0)
  completedThisWeek  Int                 @default(0)
  completedThisMonth Int                 @default(0)
  tenantId           String              @default("gyc")
  AsanaAssigneeLoad  AsanaAssigneeLoad[]
}

model CXHandoff {
  id                Int                 @id @default(autoincrement())
  clientName        String
  clientId          String?
  repName           String?
  closedAt          DateTime            @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  pipelinePhase     String              @default("phase1-mvp")
  rawOutputJson     Json
  assignedGA        String?
  assignedGAEmail   String?
  assignedGAAt      DateTime?           @db.Timestamptz(6)
  tenantId          String              @default("gyc")
  CXHandoffCall     CXHandoffCall[]
  CXHandoffDataGap  CXHandoffDataGap[]
  PromiseLedgerItem PromiseLedgerItem[]

  @@unique([clientName, closedAt])
  @@index([closedAt])
}

model Client {
  id                String              @id
  acronym           String              @unique
  name              String
  sheetId           String
  funnelTab         String
  status            String              @default("active")
  teamNotes         String?
  notesBy           String?
  notesAt           DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime            @default(now())
  tenantId          String              @default("gyc")
  ClientFunnelMonth ClientFunnelMonth[]

  @@index([tenantId])
}

model ClientFunnelMonth {
  id           String   @id
  clientId     String
  month        String
  locationName String   @default("default")
  leads        Int      @default(0)
  tours        Int      @default(0)
  registered   Int      @default(0)
  revenue      Float    @default(0)
  leadToTour   Float?
  tourToReg    Float?
  leadToReg    Float?
  syncedAt     DateTime @default(now())
  tenantId     String   @default("gyc")
  Client       Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, month, locationName])
  @@index([tenantId])
}

model ClientGAMetrics {
  acronym            String
  propertyId         String   @map("propertyId")
  period             String
  sessions           Int      @default(0)
  activeUsers        Int      @default(0) @map("activeUsers")
  newUsers           Int      @default(0) @map("newUsers")
  bounceRate         Float    @default(0) @map("bounceRate")
  organicSearch      Int      @default(0) @map("organicSearch")
  paidSearch         Int      @default(0) @map("paidSearch")
  directSessions     Int      @default(0) @map("directSessions")
  organicSocial      Int      @default(0) @map("organicSocial")
  paidSocial         Int      @default(0) @map("paidSocial")
  referral           Int      @default(0)
  avgSessionDuration Float    @default(0) @map("avgSessionDuration")
  syncedAt           DateTime @default(now()) @map("syncedAt") @db.Timestamptz(6)
  tenantId           String   @default("gyc")

  @@id([acronym, period])
  @@index([period, sessions(sort: Desc)])
  @@index([tenantId])
}

model DailyRevenue {
  id             Int      @id @default(autoincrement())
  date           String   @unique
  amount         Float
  chargeCount    Int      @default(0)
  syncedAt       DateTime @default(now())
  organizationId String   @default("default")
  tenantId       String   @default("gyc")

  @@index([tenantId])
}

model Organization {
  id            Int             @id @default(autoincrement())
  name          String
  slug          String          @unique
  industry      String?
  logoUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  tenantId      String          @default("gyc")
  ApiConnection ApiConnection[]
  User          User[]
}

model PromiseLedgerItem {
  id             Int       @id @default(autoincrement())
  handoffId      Int
  promiseText    String
  category       String
  owner          String?
  confidence     String?
  riskFlag       String?
  reviewStatus   String    @default("Pending Review")
  reviewComment  String?
  evidenceSource String?
  evidenceLink   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  tenantId       String    @default("gyc")
  CXHandoff      CXHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([handoffId])
  @@index([category])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model StripeCustomer {
  id             String    @id
  name           String?
  email          String?
  status         String
  mrr            Float     @default(0)
  createdAt      DateTime
  canceledAt     DateTime?
  updatedAt      DateTime
  organizationId String    @default("default")
  ghlContactId   String?
  companyName    String?
  phone          String?
  tags           String[]
  ownerName      String?
  tenantId       String    @default("gyc")
  acronym        String?

  @@index([ghlContactId])
  @@index([tenantId])
}

model StripeMetrics {
  id               Int      @id @default(autoincrement())
  syncedAt         DateTime @default(now())
  mrr              Float
  totalRevenue     Float
  activeCustomers  Int
  newCustomers     Int
  churnedCustomers Int
  netRevenue       Float
  organizationId   String   @default("default")
  tenantId         String   @default("gyc")

  @@index([tenantId])
}

model SyncLog {
  id             Int      @id @default(autoincrement())
  source         String
  status         String
  message        String?
  syncedAt       DateTime @default(now())
  organizationId String   @default("default")
}

model User {
  id             String       @id
  name           String
  email          String       @unique
  passwordHash   String?
  role           String       @default("viewer")
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  disabled       Boolean?     @default(false)
  tenantId       String       @default("gyc")
  Organization   Organization @relation(fields: [organizationId], references: [id])
  UserTeam       UserTeam[]

  @@index([tenantId])
}

model UserTeam {
  id     String @id
  userId String
  team   String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, team])
}

model ReconDraft {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prospectName  String
  websiteUrl    String
  requestedBy   String
  status        String          @default("draft")
  rawAutoData   Json            @default("{}")
  validatedData Json?
  reviewedBy    String?
  reviewedAt    DateTime?       @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  tenantId      String          @default("gyc")
  ReconLocation ReconLocation[]

  @@index([status, createdAt(sort: Desc)])
}

model ReconLocation {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconDraftId  String     @db.Uuid
  locationName  String
  address       String?
  city          String?
  state         String?
  googleMapsUrl String?
  gbpClaimed    String     @default("unknown")
  gbpStatus     String     @default("not-found")
  reviewNotes   String?
  autoData      Json       @default("{}")
  manualData    Json?
  locationIndex Int        @default(0)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  tenantId      String     @default("gyc")
  ReconDraft    ReconDraft @relation(fields: [reconDraftId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reconDraftId, locationIndex])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ZoomCall {
  id                   String    @id @default(dbgenerated("gen_random_uuid()"))
  meetingId            String?
  meetingUuid          String?
  meetingTopic         String?
  startedAt            DateTime? @db.Timestamptz(6)
  durationSecs         Int?
  repName              String?
  clientName           String?
  callDate             DateTime? @db.Date
  callLink             String?
  matchMethod          String?
  matchConfidence      Float?    @default(0)
  matchReasonCode      String?
  sourceRef            String?
  purposes             String[]  @default([])
  createdAt            DateTime? @default(now()) @db.Timestamptz(6)
  classificationStatus String?   @default("auto")
  hostEmail            String?
  hostName             String?
  acronym              String?
  ghlContactId         String?
  ghlContactName       String?
  ghlMatchConfidence   Float?
  ghlMatchMethod       String?
  ghlMatchCandidates   Json?
  tenantId             String    @default("gyc")
  topic                String?
  startTime            DateTime? @db.Timestamp(6)
  duration             Int?
  participants         Json?
  recordingUrl         String?
  transcriptUrl        String?
  transcriptText       String?
  aiSummary            String?
  aiClassification     String?
  aiConfidence         Decimal?  @db.Decimal(3, 2)
  classifiedAs         String?
  classifiedBy         String?
  classifiedAt         DateTime? @db.Timestamp(6)
  ghlPipelineStage     String?
  assignedRepEmail     String?
  assignedRepName      String?
  status               String?   @default("pending")
  workflowTriggered    String?
  notes                String?
  syncedAt             DateTime? @default(now()) @db.Timestamp(6)
  clientProfileId      Int?
  dealClosed           Boolean?  @default(false)
  onboardingAgentEmail String?
  onboardingAgentName  String?
  gaEmail              String?
  gaName               String?

  @@unique([meetingId, sourceRef])
  @@index([meetingId])
  @@index([callDate])
  @@index([clientName])
  @@index([aiClassification])
  @@index([startTime])
  @@index([status])
  @@index([tenantId])
}

model ZoomTranscript {
  id                    String                  @id(map: "ZoomTranscript_new_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomCallId            String                  @unique(map: "ZoomTranscript_new_zoomCallId_key") @db.Uuid
  vttRaw                String
  parsedAt              DateTime?               @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  tenantId              String                  @default("gyc")
  ZoomTranscriptSegment ZoomTranscriptSegment[]

  @@index([zoomCallId])
}

model ZoomTranscriptSegment {
  id             String         @id(map: "ZoomTranscriptSegment_new_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId   String         @db.Uuid
  startMs        Int
  endMs          Int?
  speaker        String?
  text           String
  tags           String[]       @default([])
  purposes       String[]       @default([])
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  ZoomTranscript ZoomTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ZoomTranscriptSegment_new_transcriptId_fkey")

  @@index([transcriptId])
  @@index([startMs])
}

model CallAnalysis {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomCallId   String   @db.Uuid
  purpose      String
  analysisJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenantId     String   @default("gyc")

  @@unique([zoomCallId, purpose])
  @@index([purpose])
}

model CXHandoffCall {
  handoffId  Int
  zoomCallId String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenantId   String    @default("gyc")
  CXHandoff  CXHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([handoffId, zoomCallId])
  @@index([zoomCallId])
}

model ZendeskAssigneeLoad {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  name            String
  openCount       Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskMonthlyVolume {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  month           String
  count           Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskOrgTicket {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  orgName         String
  orgId           String
  openCount       Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskResolutionBucket {
  id              Int             @id @default(autoincrement())
  snapshotId      Int
  label           String
  minHours        Float
  maxHours        Float
  count           Int
  ZendeskSnapshot ZendeskSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model ZendeskSnapshot {
  id                      Int                       @id @default(autoincrement())
  organizationId          String                    @default("default")
  syncedAt                DateTime                  @default(now())
  queueNew                Int                       @default(0)
  queueOpen               Int                       @default(0)
  queuePending            Int                       @default(0)
  queueHold               Int                       @default(0)
  queueTotal              Int                       @default(0)
  createdThisMonth        Int                       @default(0)
  resolvedThisMonth       Int                       @default(0)
  resolutionRate          Float                     @default(0)
  resTimeMean             Float                     @default(0)
  resTimeMedian           Float                     @default(0)
  resTimeMode             Float                     @default(0)
  resTimeSample           Int                       @default(0)
  typeWebsiteBuild        Int                       @default(0)
  typeWebsiteHelpdesk     Int                       @default(0)
  typeSMM                 Int                       @default(0)
  typeGoogleAds           Int                       @default(0)
  typeCRM                 Int                       @default(0)
  firstReplyTimeMean      Float                     @default(0)
  firstReplyTimeMedian    Float                     @default(0)
  firstReplyTimeSample    Int                       @default(0)
  overdueTickets          Int                       @default(0)
  ZendeskAssigneeLoad     ZendeskAssigneeLoad[]
  ZendeskMonthlyVolume    ZendeskMonthlyVolume[]
  ZendeskOrgTicket        ZendeskOrgTicket[]
  ZendeskResolutionBucket ZendeskResolutionBucket[]
}

model ClientWebsiteAuditSnapshot {
  id                BigInt    @id @default(autoincrement())
  tenantId          String    @default("gyc")
  clientAcronym     String
  periodMonth       String
  websiteUrl        String?
  pageSpeedScore    Int?
  pageSpeedLcp      Decimal?  @db.Decimal(8, 2)
  pageSpeedTbt      Decimal?  @db.Decimal(10, 2)
  pageSpeedCls      Decimal?  @db.Decimal(8, 3)
  mobileScore       Int?
  mobileMaxScore    Int?
  technicalSeoScore Int?
  topIssues         Json      @default("[]")
  source            String?
  checkedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(6)
  pageSpeedData     Json?
  mobileData        Json?
  technicalSeoData  Json?

  @@unique([tenantId, clientAcronym, periodMonth], map: "ClientWebsiteAuditSnapshot_client_period_unique")
  @@index([tenantId, clientAcronym, periodMonth(sort: Desc)], map: "ClientWebsiteAuditSnapshot_client_period_idx")
}

model GBPLocation {
  id                Int           @id @default(autoincrement())
  tenantId          String        @default("gyc")
  clientAcronym     String
  locationName      String
  gbpPlaceId        String?
  gbpUrl            String?
  address           String?
  city              String?
  state             String?
  isActive          Boolean?      @default(true)
  createdAt         DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt         DateTime?     @default(now()) @db.Timestamp(6)
  capacity          Int?
  currentEnrollment Int?
  avgTuition        Decimal?      @db.Decimal(10, 2)
  liveDataSnapshot  Json?
  liveDataUpdatedAt DateTime?     @db.Timestamptz(6)
  heatmapEnabled    Boolean?      @default(false)
  seoLocationName   String?
  locationVerified  Boolean?      @default(false)
  placeId           String?       @unique
  cid               String?
  latitude          Float?
  longitude         Float?
  lastSyncedAt      DateTime?     @db.Timestamptz(6)
  GBPAudit          GBPAudit[]
  reviews           GBPReview[]
  snapshots         GBPSnapshot[]

  @@unique([tenantId, clientAcronym, locationName])
  @@index([tenantId, clientAcronym], map: "GBPLocation_client_idx")
}

model GBPSnapshot {
  id                Int         @id @default(autoincrement())
  tenantId          String      @default("gyc")
  locationId        Int
  snapshotDate      DateTime    @db.Date
  reviewCount       Int?
  avgRating         Decimal?    @db.Decimal(3, 2)
  photoCount        Int?
  postCount         Int?
  responseRate      Decimal?    @db.Decimal(5, 2)
  rankKeyword1      Int?
  rankKeyword2      Int?
  syncedAt          DateTime?   @default(now()) @db.Timestamp(6)
  rating            Float?
  businessStatus    String?
  isVerified        Boolean     @default(false)
  viewCount         Int?
  searchCount       Int?
  callCount         Int?
  websiteClicks     Int?
  directionRequests Int?
  rawData           Json?
  location          GBPLocation @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([locationId, snapshotDate])
  @@index([locationId, snapshotDate(sort: Desc)])
}

model GBPReview {
  id               String      @id
  locationId       Int
  authorName       String
  rating           Int
  text             String?
  publishedAt      DateTime    @db.Timestamptz(6)
  ownerResponse    String?
  ownerRespondedAt DateTime?   @db.Timestamptz(6)
  firstSeenAt      DateTime    @default(now()) @db.Timestamptz(6)
  location         GBPLocation @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([locationId, publishedAt(sort: Desc)])
}

model ClientWebsiteTrafficMonthly {
  id                 BigInt    @id @default(autoincrement())
  tenantId           String    @default("gyc")
  clientAcronym      String
  propertyId         String?
  periodMonth        String
  sessions           Int?
  activeUsers        Int?
  newUsers           Int?
  engagementRate     Int?
  bounceRate         Int?
  avgSessionDuration Decimal?  @db.Decimal(10, 2)
  source             String?
  checkedAt          DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, clientAcronym, periodMonth], map: "ClientWebsiteTrafficMonthly_client_period_unique")
  @@index([tenantId, clientAcronym, periodMonth(sort: Desc)], map: "ClientWebsiteTrafficMonthly_client_period_idx")
}

model CompetitorScan {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("gyc")
  clientAcronym String
  locationId    Int
  scannedAt     DateTime @default(now())
  radiusMiles   Float    @default(5)
  competitors   Json

  @@index([clientAcronym, locationId, scannedAt(sort: Desc)], map: "CompetitorScan_client_loc_scanned_idx")
}

model ClientMeeting {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acronym           String
  meetingDate       DateTime  @db.Timestamptz(6)
  meetingType       String
  title             String?
  hostEmail         String?
  hostName          String?
  attendees         String[]  @default([])
  durationSecs      Int?
  zoomMeetingId     String?
  zoomCallId        String?   @db.Uuid
  execSummary       String?
  topics            Json?
  decisions         Json?
  tasks             Json?
  outstandingIssues Json?
  rawSummaryJson    Json?
  source            String    @default("zoom_scribe")
  status            String    @default("pending_review")
  reviewedBy        String?
  submittedAt       DateTime? @db.Timestamptz(6)
  notionUrl         String?
  transcriptUrl     String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([acronym])
  @@index([status])
  @@index([meetingDate])
  @@index([source])
}

model ActivityLog {
  id            String    @id
  tenantId      String    @default("gyc")
  type          String
  referenceId   String?
  referenceType String?
  entityId      String?
  entityType    String?
  summary       String
  detail        Json?
  actorEmail    String?
  actorName     String?
  createdAt     DateTime? @default(now()) @db.Timestamp(6)

  @@index([entityId])
  @@index([referenceId])
  @@index([tenantId])
  @@index([type])
}

model AgentAuditLog {
  id              BigInt   @id @default(autoincrement())
  tenantId        String   @default("gyc")
  agentId         String
  agentName       String
  action          String
  target          String?
  targetId        String?
  summary         String?
  status          String   @default("ok")
  errorMessage    String?
  durationMs      Int?
  recordsAffected Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId])
}

model AgentJobCheckpoint {
  id           BigInt    @id @default(autoincrement())
  tenantId     String    @default("gyc")
  jobId        String
  agentId      String
  jobType      String
  status       String    @default("running")
  checkpoint   Json?
  inputContext Json?
  outputSoFar  Json?
  startedAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  errorMessage String?

  @@unique([jobId, agentId])
  @@index([agentId])
  @@index([startedAt(sort: Desc)])
  @@index([status])
}

model AgreementsSnapshot {
  id          BigInt    @id @default(autoincrement())
  syncedAt    DateTime  @default(now()) @db.Timestamptz(6)
  docId       String    @unique
  name        String
  status      String
  sentStatus  String
  amount      Decimal?  @db.Decimal(12, 2)
  mrr         Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime? @db.Timestamptz(6)
  modifiedAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  recipients  String[]
  tokens      Json?

  @@index([createdAt(sort: Desc)], map: "AS_createdAt_idx")
  @@index([sentStatus], map: "AS_sentStatus_idx")
  @@index([status], map: "AS_status_idx")
  @@index([syncedAt(sort: Desc)], map: "AS_syncedAt_idx")
}

model CXHandoffDataGap {
  id            Int       @id @default(autoincrement())
  handoffId     Int
  source        String
  gapCode       String
  description   String
  filledBy      String?
  filledAt      DateTime? @db.Timestamptz(6)
  resolvedValue String?
  status        String    @default("open")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  tenantId      String    @default("gyc")
  CXHandoff     CXHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([handoffId, source, gapCode, description])
  @@index([handoffId])
  @@index([status])
}

model ClientContract {
  id                     Int       @id @default(autoincrement())
  ghlContactId           String?
  clientName             String
  acronym                String?
  documentRef            String?
  contractType           String?
  programLevel           String?
  signedAt               DateTime? @db.Timestamptz(6)
